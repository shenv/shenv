# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-2.01" "https://ftpmirror.gnu.org/bash/bash-2.01.tar.gz#919255f75d903c04722f633aa5ce26739b84aea85de967cac135ac1227bc8243" warn_eol standard
