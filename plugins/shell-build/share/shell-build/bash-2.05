# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-2.05" "https://ftpmirror.gnu.org/bash/bash-2.05.tar.gz#f3a9146366bfd9ef78d85be02e818b39614be177650a7ced441cc3b716cb1f0f" warn_eol standard
