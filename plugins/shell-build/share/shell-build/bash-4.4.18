# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-4.4.18" "https://ftpmirror.gnu.org/bash/bash-4.4.18.tar.gz#604d9eec5e4ed5fd2180ee44dd756ddca92e0b6aa4217bbab2b6227380317f23" warn_eol standard
