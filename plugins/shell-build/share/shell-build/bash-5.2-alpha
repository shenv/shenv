# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-5.2-alpha" "https://ftp.gnu.org/pub/gnu/bash/bash-5.2-alpha.tar.gz#5da1ce90054f17fde5f9b15d56581be55b51be28d0f9cd8b36a776db4f4af006" warn_eol standard
