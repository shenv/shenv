# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-2.04" "https://ftpmirror.gnu.org/bash/bash-2.04.tar.gz#8053c0e50f63babd2c22cc048d49eccb3260a298f7af1173006f8395b617a361" warn_eol standard
