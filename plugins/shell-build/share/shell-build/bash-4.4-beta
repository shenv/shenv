# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-4.4-beta" "https://ftpmirror.gnu.org/bash/bash-4.4-beta.tar.gz#8273c415b70260baaf7a9fdc9632451cd3987718fd054ee7ee13d7613808d231" warn_eol standard
