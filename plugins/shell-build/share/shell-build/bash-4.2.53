# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-4.2.53" "https://ftpmirror.gnu.org/bash/bash-4.2.53.tar.gz#e81b256ba44132db14c0d81c558ceb64a5c373414fe58d2e94b1cb487985cb8b" warn_eol standard
