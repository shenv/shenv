# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-4.4-beta2" "https://ftpmirror.gnu.org/bash/bash-4.4-beta2.tar.gz#3a8c4aa40f9ba6c311f4f6a637ae290c0148b828617b0a263a416ba923111f51" warn_eol standard
