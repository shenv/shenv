# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-5.2.15" "https://ftp.gnu.org/pub/gnu/bash/bash-5.2.15.tar.gz#13720965b5f4fc3a0d4b61dd37e7565c741da9a5be24edc2ae00182fc1b3588c" warn_eol standard
