# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-5.1-alpha" "https://ftpmirror.gnu.org/bash/bash-5.1-alpha.tar.gz#88043095bfb6123d97a293f2b5c07b7e6076a201963afcf9bb7909fd974bc05b" warn_eol standard
