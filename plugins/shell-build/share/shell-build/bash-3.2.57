# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-3.2.57" "https://ftpmirror.gnu.org/bash/bash-3.2.57.tar.gz#3fa9daf85ebf35068f090ce51283ddeeb3c75eb5bc70b1a4a7cb05868bfe06a4" warn_eol standard
