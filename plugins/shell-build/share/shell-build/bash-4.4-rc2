# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-4.4-rc2" "https://ftpmirror.gnu.org/bash/bash-4.4-rc2.tar.gz#199ec0166d50a765eec74dc258b006b06cf6b59901d7ff40510c82aae37ad994" warn_eol standard
