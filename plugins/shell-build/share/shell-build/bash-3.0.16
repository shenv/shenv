# Upstream supports only the current Bash release; these sources predate Bash 5.3.
# https://lists.gnu.org/archive/html/bug-bash/2023-02/msg00080.html
install_package "bash-3.0.16" "https://ftpmirror.gnu.org/bash/bash-3.0.16.tar.gz#4dea6ad713264974424d8ef2e9c4e1d6431ee29c6f8bd2cd0f7c3745455e7747" warn_eol standard
