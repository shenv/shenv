#!/bin/bash
#
# Summary: Run an executable with the selected shell version
#
# Usage: shenv exec <command> [arg1 arg2...]
#
# Runs an executable from the selected shell version without changing
# PATH. Commands in the launched shell can then use shims to select a
# local version after changing directories.

set -e
[ -n "$SHENV_DEBUG" ] && set -x

# Provide shenv completions
if [ "$1" = "--complete" ]; then
  exec shenv-shims --short
fi

# An empty exported value must not become an implicit override in child shells.
if [ -z "$SHENV_VERSION" ]; then
  unset SHENV_VERSION
fi
SHENV_VERSION="$(SHENV_DIR="${SHENV_DIR:-$PWD}" shenv-version-name)"
SHENV_COMMAND="$1"

if [ -z "$SHENV_COMMAND" ]; then
  shenv-help --usage exec >&2
  exit 1
fi

# Use the resolved version for lookup without exporting an implicit shell override.
SHENV_COMMAND_PATH="$(SHENV_VERSION="$SHENV_VERSION" shenv-which "$SHENV_COMMAND")"
SHENV_BIN_PATH="${SHENV_COMMAND_PATH%/*}"

OLDIFS="$IFS"
IFS=$'\n' scripts=(`shenv-hooks exec`)
IFS="$OLDIFS"
for script in "${scripts[@]}"; do
  source "$script"
done

shift 1
exec -a "$SHENV_COMMAND" "$SHENV_COMMAND_PATH" "$@"
